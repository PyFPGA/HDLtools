{%- set all_ports = [] %}
{%- set port_names = [] %}
{%- for name, props in ports.items() %}
  {%- set dir = props.direction | default('') %}
  {%- set type = props.type | default('') %}
  {%- set packed = props.packed | default('') %}
  {%- set unpacked = props.unpacked | default('') %}
  {%- set port_str = dir ~ " " ~ type ~ " " ~ packed ~ " " ~ name ~ " " ~ unpacked %}
  {%- set _ = all_ports.append(port_str) %}
  {%- set _ = port_names.append(name) %}
{%- endfor -%}
module {{ name }} {% if parameters -%}#(
  {%- for name, props in parameters.items() -%}
    {%- set type = props.type | default('') %}
    {%- set packed = props.packed | default('') %}
  parameter {{ type }} {{ packed }} {{ name }} = {{ props.default }}{% if not loop.last %},{% endif %}
  {%- endfor %}
){% endif %}(
{%- for port in all_ports %}
  {{ port }}{% if not loop.last %},{% endif %}
{%- endfor %}
);
endmodule
